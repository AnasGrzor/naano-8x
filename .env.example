APIFY_API_KEY=
APIFY_PROFILE_ACTOR_ID=themineworks/linkedin-profile-scraper
APIFY_POSTS_ACTOR_ID=capable_cauldron/linkedin-profile-posts-scraper

# Neon Postgres connection string (server-only, never exposed to the client).
DATABASE_URL=

# Better Auth (server-only, never exposed to the client).
# Generate with: openssl rand -base64 32  (at least 32 characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional social providers. A provider is only enabled when BOTH of its
# variables are set. Add the callback URLs in each provider console:
# http://localhost:3000/api/auth/callback/google
# http://localhost:3000/api/auth/callback/linkedin
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Assumed engagement rate used only to estimate reach from public post
# engagement (reactions + comments + shares). Not official LinkedIn Analytics.
ESTIMATED_LINKEDIN_ENGAGEMENT_RATE=0.02
